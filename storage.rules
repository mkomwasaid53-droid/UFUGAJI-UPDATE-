rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check ownership
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Marketplace Products media storage (images and video)
    match /marketplace/products/{sellerUid}/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(sellerUid) && (request.resource == null || request.resource.size <= 55 * 1024 * 1024);
    }

    // Marketplace Digital Shops branding media (logo, cover)
    match /marketplace/shops/{sellerUid}/{shopId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(sellerUid);
    }

    // User profile and farm media
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // Marketplace Private Inbox Attachments (Strictly protected; never public)
    match /marketplace/inbox/{conversationId}/{allPaths=**} {
      allow read, write: if false; // Accessible only via server authenticated participant gateway
    }

    // Gumzo Community Admin Posts media (Retirement V1.0: Read-only preserved for historical content)
    match /gumzo/posts/{groupId}/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Gumzo Community Member Comments media (Retirement V1.0: Read-only preserved for historical content)
    match /gumzo/comments/{groupId}/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Corporate Campaigns creative banners (Zero-Trust Privacy V1.0)
    // Direct client read & write access is strictly denied.
    // All previews and deliveries are server-mediated to enforce strict lifecycle
    // governance: DRAFT/ARCHIVED/PAUSED are private to authorized administrators;
    // only APPROVED, enabled, and active campaigns can be delivered via the gateway.
    match /campaigns/{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }

    // Default fallback: reject all unmapped paths
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
