{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User profile records for farmers, sellers, and administrators.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth user UID" },
        "email": { "type": "string", "description": "Email address" },
        "role": { "type": "string", "enum": ["farmer", "seller", "pro", "admin"], "description": "User access role" },
        "displayName": { "type": "string", "description": "Full name of the farmer/user" },
        "name": { "type": "string", "description": "Backwards-compatible full name" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "location": { "type": "string", "description": "Living location / region in Tanzania" },
        "region": { "type": "string", "description": "Backwards-compatible region" },
        "mainLivestock": { "type": "array", "items": { "type": "string" }, "description": "Main livestock kept (e.g. kuku, ng'ombe, mbuzi)" },
        "livestockTypes": { "type": "array", "items": { "type": "string" }, "description": "Breeds and types of livestock" },
        "farmingType": { "type": "string", "description": "Primary livestock or farming type" },
        "createdAt": { "type": "string", "description": "Timestamp of user registration" },
        "updatedAt": { "type": "string", "description": "Timestamp of last update" }
      },
      "subcollections": {
        "aiConversations": {
          "title": "AI Assistant Conversations",
          "description": "Conversation sessions between the farmer and the AI Assistant.",
          "type": "object",
          "properties": {
            "conversationId": { "type": "string" },
            "uid": { "type": "string" },
            "title": { "type": "string" },
            "createdAt": { "type": "string" },
            "updatedAt": { "type": "string" },
            "lastMessageAt": { "type": "string" },
            "messageCount": { "type": "number" },
            "status": { "type": "string", "enum": ["active", "archived", "deleted"] },
            "isCustomTitle": { "type": "boolean" }
          },
          "subcollections": {
            "messages": {
              "title": "AI Assistant Chat Messages",
              "description": "Individual messages in an AI conversation thread.",
              "type": "object",
              "properties": {
                "messageId": { "type": "string" },
                "role": { "type": "string", "enum": ["user", "assistant", "model"] },
                "content": { "type": "string" },
                "createdAt": { "type": "string" },
                "personalized": { "type": "boolean" }
              },
              "required": ["messageId", "role", "content", "createdAt"]
            }
          },
          "required": ["conversationId", "title", "createdAt", "updatedAt"]
        },
        "livestockRecords": {
          "title": "Personal Livestock Records (My Assistant)",
          "description": "Livestock count, categories, breeds, batches, and notes owned by the authenticated farmer.",
          "type": "object",
          "properties": {
            "recordId": { "type": "string" },
            "livestockCategory": { "type": "string" },
            "livestockType": { "type": "string" },
            "quantity": { "type": "number" },
            "recordName": { "type": "string" },
            "dateAdded": { "type": "string" },
            "notes": { "type": "string" },
            "createdAt": { "type": "string" },
            "updatedAt": { "type": "string" }
          },
          "subcollections": {
            "events": {
              "title": "Livestock Events & History",
              "description": "Historical timeline of vaccinations, treatments, mortality, purchases, sales, feedings, births, additions, and observations.",
              "type": "object",
              "properties": {
                "eventId": { "type": "string" },
                "eventType": {
                  "type": "string",
                  "enum": [
                    "addition",
                    "birth",
                    "purchase",
                    "sale",
                    "death",
                    "mortality",
                    "vaccination",
                    "treatment",
                    "feed",
                    "observation",
                    "other"
                  ]
                },
                "eventDate": { "type": "string" },
                "quantity": { "type": ["number", "null"] },
                "title": { "type": "string" },
                "notes": { "type": "string" },
                "description": { "type": "string" },
                "createdAt": { "type": "string" },
                "updatedAt": { "type": "string" }
              },
              "required": ["eventId", "eventType", "eventDate", "title", "createdAt", "updatedAt"]
            }
          },
          "required": ["recordId", "livestockCategory", "livestockType", "quantity", "dateAdded", "createdAt", "updatedAt"]
        },
        "sellerProfile": {
          "title": "Seller Capability & Digital Shop",
          "description": "Optional seller capability, store profile, digital shop, and product catalogues.",
          "type": "object",
          "properties": {
            "profile": {
              "type": "object",
              "properties": {
                "uid": { "type": "string" },
                "businessName": { "type": "string" },
                "displayName": { "type": "string" },
                "phone": { "type": "string" },
                "location": { "type": "string" },
                "verificationStatus": { "type": "string", "enum": ["unverified", "pending", "verified"] },
                "logoImage": { "type": "string", "description": "Seller avatar / logo image URL" },
                "createdAt": { "type": "string" },
                "updatedAt": { "type": "string" }
              }
            },
            "shop": {
              "type": "object",
              "properties": {
                "shopId": { "type": "string" },
                "sellerId": { "type": "string" },
                "shopName": { "type": "string" },
                "description": { "type": "string" },
                "location": { "type": "string" },
                "phone": { "type": "string" },
                "whatsapp": { "type": "string" },
                "isPublished": { "type": "boolean" },
                "logoImage": { "type": "string", "description": "Shop logo image URL" },
                "coverImage": { "type": "string", "description": "Shop cover banner image URL" },
                "createdAt": { "type": "string" },
                "updatedAt": { "type": "string" }
              },
              "subcollections": {
                "catalogues": {
                  "title": "Digital Shop Catalogues / Sections",
                  "description": "Product catalogues/sections organizing a seller's products.",
                  "type": "object",
                  "properties": {
                    "catalogueId": { "type": "string" },
                    "shopId": { "type": "string" },
                    "sellerId": { "type": "string" },
                    "name": { "type": "string" },
                    "description": { "type": "string" },
                    "icon": { "type": "string" },
                    "displayOrder": { "type": "number" },
                    "isActive": { "type": "boolean" },
                    "createdAt": { "type": "string" },
                    "updatedAt": { "type": "string" }
                  },
                  "required": ["catalogueId", "shopId", "sellerId", "name", "displayOrder", "isActive", "createdAt", "updatedAt"]
                }
              },
              "required": ["shopId", "sellerId", "shopName", "location", "phone", "isPublished", "createdAt", "updatedAt"]
            }
          }
        },
        "professionalProfile": {
          "title": "Professional Livestock / Veterinary Profile",
          "description": "Daktari Mtaani Kwako profile and private credentials for verified veterinarians and extension officers.",
          "type": "object",
          "properties": {
            "profile": {
              "type": "object",
              "properties": {
                "uid": { "type": "string" },
                "fullName": { "type": "string" },
                "professionalTitle": { "type": "string" },
                "professionalType": { "type": "string" },
                "phone": { "type": "string" },
                "whatsapp": { "type": "string" },
                "region": { "type": "string" },
                "district": { "type": "string" },
                "wardOrArea": { "type": "string" },
                "locationDescription": { "type": "string" },
                "livestockSpecialties": { "type": "array", "items": { "type": "string" } },
                "services": { "type": "array", "items": { "type": "string" } },
                "availability": { "type": "string" },
                "emergencyAvailable": { "type": "boolean" },
                "bio": { "type": "string" },
                "profileImage": { "type": "string" },
                "registrationStatus": { "type": "string", "enum": ["not_registered", "registered", "submitted", "active", "suspended"] },
                "verificationStatus": { "type": "string", "enum": ["unverified", "pending", "verified", "rejected", "needs_correction"] },
                "verificationSubmittedAt": { "type": "string" },
                "verifiedAt": { "type": "string" },
                "adminVerificationNotes": { "type": "string" },
                "registrationFee": { "type": "number" },
                "registrationPaymentStatus": { "type": "string", "enum": ["unpaid", "pending", "paid"] },
                "subscriptionStatus": { "type": "string", "enum": ["unpaid", "free_trial", "pending", "paid", "expired"] },
                "subscriptionStart": { "type": "string" },
                "subscriptionEnd": { "type": "string" },
                "freeTrialStart": { "type": "string" },
                "freeTrialEnd": { "type": "string" },
                "nextPaymentDue": { "type": "string" },
                "createdAt": { "type": "string" },
                "updatedAt": { "type": "string" }
              }
            },
            "credentials": {
              "type": "object",
              "properties": {
                "uid": { "type": "string" },
                "professionalRegistrationNumber": { "type": "string" },
                "professionalQualification": { "type": "string" },
                "institution": { "type": "string" },
                "graduationYear": { "type": "string" },
                "documentUrls": { "type": "array", "items": { "type": "string" } },
                "documentNotes": { "type": "string" },
                "submittedAt": { "type": "string" },
                "updatedAt": { "type": "string" }
              }
            }
          }
        }
      },
      "required": ["uid", "email", "role", "displayName", "phone", "location", "mainLivestock", "livestockTypes", "createdAt", "updatedAt"]
    },
    "records": {
      "title": "Farm Records",
      "description": "Livestock records, feeding logs, vaccination schedules, and production data.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "category": { "type": "string", "description": "kuku, ngombe, mbuzi, nguruwe, etc." },
