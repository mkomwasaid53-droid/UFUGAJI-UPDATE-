        "count": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "category", "title", "createdAt"]
    },
    "marketplaceProducts": {
      "title": "Marketplace Products (Gulio la Mifugo & Pembejeo)",
