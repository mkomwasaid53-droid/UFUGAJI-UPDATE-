        "catalogueId": { "type": ["string", "null"], "description": "Optional catalogue within the seller shop" },
        "catalogueName": { "type": "string", "description": "Display name of the catalogue" },
        "sellerName": { "type": "string" },
        "sellerBusinessName": { "type": "string" },
        "sellerPhone": { "type": "string" },
        "sellerLocation": { "type": "string" },
        "sellerVerificationStatus": { "type": "string", "enum": ["unverified", "pending", "verified"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "subcategory": { "type": "string" },
        "price": { "type": "number" },
        "currency": { "type": "string", "enum": ["TZS", "Tsh"] },
        "unit": { "type": "string" },
        "quantityAvailable": { "type": "number" },
        "priceUpdatedAt": { "type": "string", "description": "Authoritative timestamp when seller updated price" },
        "stockUpdatedAt": { "type": "string", "description": "Authoritative timestamp when seller updated stock" },
        "priceStatus": { "type": "string", "enum": ["PROVIDED", "NOT_PROVIDED", "UNAVAILABLE", "STALE", "ERROR"] },
        "stockStatus": { "type": "string", "enum": ["IN_STOCK", "OUT_OF_STOCK", "NOT_PROVIDED", "UNAVAILABLE", "STALE", "ERROR"] },
        "location": { "type": "string" },
        "region": { "type": "string" },
        "district": { "type": "string" },
        "imageUrl": { "type": "string" },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "url": { "type": "string" },
              "thumbnailUrl": { "type": "string" },
              "isPrimary": { "type": "boolean" },
              "caption": { "type": "string" },
              "uploadedAt": { "type": "string" }
            },
            "required": ["id", "url"]
          },
          "description": "Product image gallery media"
        },
        "video": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "url": { "type": "string" },
            "storagePath": { "type": "string" },
            "thumbnailUrl": { "type": "string" },
            "durationSeconds": { "type": "number" },
            "title": { "type": "string" },
            "description": { "type": "string" },
            "createdAt": { "type": "string" },
            "updatedAt": { "type": "string" }
          },
          "required": ["id", "url", "createdAt"],
          "description": "Optional product explanation video"
        },
        "status": { "type": "string", "enum": ["active", "inactive", "sold_out", "draft"] },
        "isTestDemo": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["productId", "sellerId", "title", "category", "price", "unit", "quantityAvailable", "location", "status", "createdAt", "updatedAt"]
    },
    "marketplaceVideos": {
      "title": "Permanent Product Videos",
      "description": "Durable cloud-persisted product video chunks ensuring video demonstrations never disappear.",
